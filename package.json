{
  "name": "anonbuddy-skin",
  "version": "1.0.1",
  "private": true,
  "description": "给 WorkBuddy 桌面端换肤：注入式主题系统（不改 app.asar），带主题菜单与逐字打字标题动画",
  "homepage": "https://github.com/2939332182/anonbuddy-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2939332182/anonbuddy-skin.git"
  },
  "bugs": {
    "url": "https://github.com/2939332182/anonbuddy-skin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "bin": {
    "anonbuddy-skin": "src/cli.mjs"
  },
  "scripts": {
    "apply": "node apply-now.mjs",
    "apply:theme": "node src/cli.mjs apply --theme",
    "pause": "node src/cli.mjs pause",
    "status": "node src/cli.mjs status",
    "list": "node src/cli.mjs list",
    "create": "node src/cli.mjs create",
    "doctor": "node src/cli.mjs doctor",
    "lint": "node scripts/lint-menu.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:static": "node scripts/run-tests.mjs --suite static",
    "test:core": "node scripts/run-tests.mjs --suite core",
    "test:ui": "node scripts/run-tests.mjs --suite ui",
    "test:menu": "node scripts/run-tests.mjs --suite menu",
    "test:all": "node scripts/run-tests.mjs --suite all",
    "test:list": "node scripts/run-tests.mjs --list",
    "find": "node scripts/find-workbuddy.mjs",
    "shot": "node scripts/shot-home.mjs",
    "we:extract": "node src/cli.mjs we-extract"
  }
}
